---
import { siteConfig } from "../config";

const hasTalks = siteConfig.talks && siteConfig.talks.length > 0;

// Robust YouTube ID extractor (handles watch?v=..., youtu.be/..., /embed/...)
function getYouTubeId(url) {
  if (!url) return "";
  const watchMatch = url.match(/[?&]v=([^&]+)/);
  if (watchMatch) return watchMatch[1];
  const shortMatch = url.match(/youtu\.be\/([^?&]+)/);
  if (shortMatch) return shortMatch[1];
  const embedMatch = url.match(/\/embed\/([^?&]+)/);
  if (embedMatch) return embedMatch[1];
  return "";
}
---

{hasTalks && (
  <section id="talks" class="p-8 sm:p-12 md:p-16 lg:p-24 bg-white">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
      <div class="lg:col-span-4">
        <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
          Talks
        </h2>
        <div
          class="w-[75px] h-[5px] mt-2 rounded-full"
          style={`background-color: ${siteConfig.accentColor}`}
        />
      </div>

      <div class="lg:col-span-8 space-y-10">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
          {siteConfig.talks.map((talk) => {
            const videoId = getYouTubeId(talk.link);
            const thumbnail = videoId
              ? `https://img.youtube.com/vi/${videoId}/hqdefault.jpg`
              : "/placeholder-thumbnail.jpg"; // fallback if ID not found

            return (
              <a
                href={talk.link}
                target="_blank"
                rel="noopener noreferrer"
                class="group block"
              >
                <div class="relative w-full overflow-hidden rounded-lg shadow-sm hover:shadow-md transition-shadow duration-300">
                  <img
                    src={thumbnail}
                    alt={`${talk.title} thumbnail`}
                    class="w-full aspect-video object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                </div>

                <div class="mt-3">
                  <h3
                    class="text-lg font-semibold text-gray-900 group-hover:text-[var(--accent-color)] transition-colors"
                    style={`--accent-color: ${siteConfig.accentColor}`}
                  >
                    {talk.title}
                  </h3>
                  <p class="text-sm text-gray-500">{talk.date}</p>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </section>
)}
